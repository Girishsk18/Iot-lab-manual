int ledPins[] = {2, 3, 4, 5, 6}; 
int numLeds = 5; 
int delayTime = 150; 
void setup() { 
for (int i = 0; i < numLeds; i++) { 
pinMode(ledPins[i], OUTPUT); 
} 
} 
void loop() { 
for (int i = 0; i < numLeds; i++) { 
turnOnOnly(i); 
delay(delayTime); 
} 
